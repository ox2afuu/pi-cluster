@startuml 04a-component-cluster
title Cluster components after Phase 1–3 integration

skinparam defaultFontName Menlo
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor Black
}

node "dalmasca (head, 10.42.0.1)" as Head {
    component "slurmctld" as SC
    component "slurmdbd\n(optional; not wired yet)" as SDB
    component "munge" as MH
    component "nfs-kernel-server" as NFSS
    component "Ansible runner\n(postboot service)" as Ansible
    component "sphinx.sh\n(operator entry point)" as Entry
    component "Queue::Slurm\n(Perl, loaded via\nPERL5LIB)" as QS
    folder "/srv/ivalice/sphinx-asr/" as FSHead {
        artifact "scripts/\n(ASR + sbatch shims)"
        artifact "vendor/\n(sphinxtrain + pocketsphinx + cmu_toolkit)"
        artifact "bin/aarch64/\n(built once)"
        artifact ".venv/\n(bundled wheels)"
        artifact "corpus/\nexperiments/"
    }
}

node "archadia (worker, 10.42.0.11)" as W1 {
    component "slurmd" as S1
    component "munge" as M1
    component "nfs client\n(automount /srv/ivalice)" as NFSC1
    component "job processes\n(perl slaves, sphinx_fe,\npocketsphinx_batch)" as J1
}

node "rozarria (worker, 10.42.0.12)" as W2 {
    component "slurmd" as S2
    component "munge" as M2
    component "nfs client" as NFSC2
    component "job processes" as J2
}

node "(bhujerba, nabradia, kerwon)\n10.42.0.13..15" as WN {
    component "slurmd x3" as SN
    component "munge x3" as MN
    component "nfs clients x3" as NFSCN
}

cloud "L2 /24 airgapped network" as Net

SC --> Net : 6817/tcp
SDB ..> SC
S1 --> Net : 6818/tcp
S2 --> Net : 6818/tcp
SN --> Net : 6818/tcp
MH --> Net : munge auth\n(shared munge.key)
M1 --> Net
M2 --> Net
MN --> Net
NFSS --> Net : nfs4 2049/tcp
NFSC1 --> Net
NFSC2 --> Net
NFSCN --> Net

Entry --> SC : sbatch / scancel / sacct / squeue
QS   --> SC : sbatch --parsable\n(per training partition)
Ansible --> SC : systemctl (convergence)
Ansible --> NFSS : exportfs
Ansible --> FSHead : run make, create .venv

NFSS --> FSHead : serves /srv/ivalice
NFSC1 ..> FSHead : mounts same tree
NFSC2 ..> FSHead : mounts same tree
NFSCN ..> FSHead : mounts same tree

J1 ..> FSHead : reads fileids,\nwrites model_parameters/, logdir/, result/
J2 ..> FSHead
SN ..> FSHead

note right of QS
  Queue::Slurm translates sphinxtrain's Queue
  API calls (submit_job, query_job, waitfor_job,
  cancel_job) into sbatch/scontrol/sacct/scancel.
end note

note right of FSHead
  **Single source of truth.** Every node sees
  the same bytes. SPHINX_ROOT=/srv/ivalice/sphinx-asr
  resolves on all 6.
end note

@enduml
