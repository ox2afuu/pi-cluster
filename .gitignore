assets/*
!assets/README.md
!assets/.gitkeep

# Editor / OS noise
.DS_Store
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
.venv/
venv/

# Build output
*.log
*.o
*.a

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Engineering wiki build output (mkdocs build, lefthook hooks).
site/
.cache/

# CI image build outputs (scripts/ci/build-image.sh). The image holds
# ephemeral secrets; never commit or publish it.
out/

# oh-my-claudecode local session state.
.omc/
