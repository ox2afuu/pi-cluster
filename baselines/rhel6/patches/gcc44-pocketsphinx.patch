diff -u a/vendor/pocketsphinx/src/util/genrand.c b/vendor/pocketsphinx/src/util/genrand.c
--- a/vendor/pocketsphinx/src/util/genrand.c
+++ b/vendor/pocketsphinx/src/util/genrand.c
